":{"en":"Postpone while there is fever or an active infection.","zh":"发烧或有活动性感染时延后。"},"metal-allergy":{"en":"Use non-metal or hypoallergenic contact surfaces.","zh":"使用非金属或低敏的接触面。"},"metal-implant":{"en":"Avoid strong electrical or heat stimulation over metal plates, screws or joints.","zh":"金属钢板、螺丝或人工关节上方避免强电刺激或热。"},"osteoporosis":{"en":"Gentle pressure only.","zh":"只能轻压。"},"pacemaker":{"en":"Do not use electrical stimulation near the chest; ask the clinic doctor first.","zh":"胸部附近不要用电刺激；先问诊所医生。"},"recent-surgery":{"en":"Wait for the doctor's clearance (about 3 months after an operation).","zh":"手术后需等医生批准（约 3 个月）。"},"skin-contact":{"en":"Wipe the area first and check for cream or patch residue.","zh":"先擦净该处，检查有无药膏或药贴残留。"},"skin-scar":{"en":"Avoid scar tissue.","zh":"避开疤痕组织。"},"thin-skin":{"en":"Gentle pressure; the skin bruises easily.","zh":"轻压；皮肤容易瘀青。"}}}
